PORT=6000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Required by API security (same local Redis server, separate database/prefix).
SECURITY_REDIS_URL=redis://127.0.0.1:6380/1
SECURITY_REDIS_PREFIX=ticketverse-security
RATE_LIMIT_MAX=120
# Behind a proxy: explicitly allow only its address/subnet, never arbitrary clients.
# TRUST_PROXY=127.0.0.1/32,::1/128

# Email: apply docs/email-schema.sql first. API writes outbox; worker sends SMTP.
EMAIL_ENABLED=false
EMAIL_REDIS_URL=redis://127.0.0.1:6380/0
EMAIL_QUEUE_PREFIX=ticketverse
EMAIL_RATE_PER_MINUTE=10
# EMAIL_GMAIL_USER=your-project@gmail.com
# EMAIL_GMAIL_APP_PASSWORD=your_16_character_app_password

# Orders: payment simulation is accepted only in development/test.
PAYMENT_MOCK_ENABLED=false
ORDERS_WORKER_ENABLED=false
ORDER_PAYMENT_TIMEOUT_MINUTES=15

# Local file storage (relative to the project working directory)
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# Postgres Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=ticket_db

# JWT Configuration
JWT_ACCESS_SECRET=your_access_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES=7d

# Ticket OCR worker (separate process; automatic approval starts disabled)
TICKET_WORKER_ENABLED=false
TICKET_AUTO_APPROVE_ENABLED=false
TICKET_PYTHON_PATH=python
TICKET_TESSERACT_PATH=tesseract
TICKET_SCANNER_SCRIPT=scripts/ticket-scanner/scan.py
TICKET_SCAN_TIMEOUT_SECONDS=120
# Optional local language directory containing vie/eng traineddata and configs/tsv.
# TESSDATA_PREFIX=D:/path/to/project/.runtime/ticket-ocr/tessdata
# Set a separate random secret of at least 32 characters before starting the worker.
# TICKET_CODE_HMAC_SECRET=
