NODE_ENV=development
PORT=7000
FRONTEND_URL=http://localhost:3000,http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=ticketverse
DB_PASSWORD=replace-with-your-local-password
DB_NAME=ticketverse
DB_SYNCHRONIZE=false
SECURITY_REDIS_URL=redis://127.0.0.1:6379/1
SECURITY_REDIS_PREFIX=ticketverse-security
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
RATE_LIMIT_MAX=120
TRUST_PROXY=
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# Generate a separate random QR signing key; do not reuse JWT secrets.
TICKET_QR_SECRET=replace-with-a-separate-random-key-of-at-least-32-characters
TICKET_EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tickets@example.com

# Hosted VNPay test gateway. Obtain credentials privately from VNPay.
PAYMENT_PROVIDER=VNPAY
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_QUERY_IP=127.0.0.1
VNPAY_RETURN_URL=http://localhost:7000/api/v1/payments/vnpay/return
VNPAY_FRONTEND_URL=http://localhost:3000

# DB-backed settlement/email polling; mock payouts only in development/test.
RESALE_SETTLEMENT_WORKER_ENABLED=true
