SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=23050150@student.bdu.edu.vn
SMTP_PASS=guswenxaxwjbhlzn
SMTP_FROM=23050150@student.bdu.edu.vn

# ?? 6. Cong thanh toan truc tuyen VNPay Sandbox ???????????????
PAYMENT_PROVIDER=VNPAY
VNPAY_TMN_CODE=W6226CVC
VNPAY_HASH_SECRET=SNCSKZWRALELCJWBLVYXFKGTDXRFJPXW
VNPAY_QUERY_IP=127.0.0.1
VNPAY_RETURN_URL=http://localhost:7000/api/v1/payments/vnpay/return
