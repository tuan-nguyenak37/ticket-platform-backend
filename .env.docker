# ==============================================================
# TICKETVERSE BACKEND - DOCKER ENVIRONMENT CONFIGURATION
# File cau hinh rieng biet danh cho moi truong Docker Compose
# ==============================================================

# ?? 1. Thiet lap he thong & Cong mang ?????????????????????????
NODE_ENV=development
PORT=7000
FRONTEND_URL=http://localhost:3000,http://localhost:5173
RATE_LIMIT_MAX=120
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# ?? 2. Co so du lieu PostgreSQL 16 ???????????????????????????
# Luu y: DB_HOST tro den ten service "postgres" trong network Docker
DB_HOST=postgres
DB_PORT=5432
DB_NAME=passve_v2
DB_USERNAME=myuser
DB_PASSWORD=mypassword
DB_SYNCHRONIZE=false

# Bien moi truong duoc container PostgreSQL su dung de khoi tao
POSTGRES_DB=passve_v2
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword

# ?? 3. Bo nho dem Redis 7 ?????????????????????????????????????
# Luu y: Host tro den ten service "redis" trong network Docker
REDIS_PORT=6379
SECURITY_REDIS_URL=redis://redis:6379/1
SECURITY_REDIS_PREFIX=ticketverse-security

# ?? 4. Bao mat xac thuc JWT & Ma QR ve ????????????????????????
JWT_ACCESS_SECRET=ticketverse_jwt_access_super_secret_key_docker_2026
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=ticketverse_jwt_refresh_super_secret_key_docker_2026
JWT_REFRESH_EXPIRES=7d
TICKET_QR_SECRET=0a554bbca7060d6ff52a59886d63e2fba3b03735041a89dfcc8cff8c87abd903

# ?? 5. Gui Email thong bao ve dien tu (SMTP) ??????????????????
