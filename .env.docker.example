# ==============================================================
# TICKETVERSE BACKEND - DOCKER ENVIRONMENT CONFIGURATION EXAMPLE
# Copy file nay thanh .env.docker va dien cac thong so thuc te
# ==============================================================

NODE_ENV=development
PORT=7000
FRONTEND_URL=http://localhost:3000,http://localhost:5173
RATE_LIMIT_MAX=120
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# Database PostgreSQL 16
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ticketverse
DB_USERNAME=ticketverse
DB_PASSWORD=replace-with-your-db-password
DB_SYNCHRONIZE=false

POSTGRES_DB=ticketverse
POSTGRES_USER=ticketverse
POSTGRES_PASSWORD=replace-with-your-db-password

# Redis 7
REDIS_PORT=6379
SECURITY_REDIS_URL=redis://redis:6379/1
SECURITY_REDIS_PREFIX=ticketverse-security

# JWT & QR
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-for-access
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-for-refresh
JWT_REFRESH_EXPIRES=7d
TICKET_QR_SECRET=replace-with-at-least-32-random-characters-for-qr

# Email (SMTP)
TICKET_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# VNPay Sandbox
PAYMENT_PROVIDER=VNPAY
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_QUERY_IP=127.0.0.1
VNPAY_RETURN_URL=http://localhost:7000/api/v1/payments/vnpay/return
VNPAY_FRONTEND_URL=http://localhost:3000

RESALE_SETTLEMENT_WORKER_ENABLED=true

# Tu dong khoi tao du lieu mau thuc te khi chay migrate
SEED_SAMPLE_DATA=true
