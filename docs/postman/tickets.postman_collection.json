    {
      "name": "05 - Review management",
      "item": [
        {
          "name": "Review - Login ADMIN",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Luồng quản trị vé; chưa chạy request tự động."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set('reviewToken', pm.response.json().data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Review - List tickets needing review",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tickets/manage?page=1&limit=20",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "description": "Inspect queue; reviewTicketId stays on the ticket you created or explicitly selected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Review - Ticket report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tickets/manage/{{reviewTicketId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "description": "Luồng quản trị vé; chưa chạy request tự động."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('selectedCodeId');",
                  "pm.environment.unset('checkVersion');",
                  "if (pm.response.code === 200) {",
                  "  const check = pm.response.json().data.check;",
                  "  if (check?.status === 'completed') {",
                  "    pm.environment.set('checkVersion', check.version);",
                  "    if (check.codes?.length === 1) pm.environment.set('selectedCodeId', check.codes[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Review - View original file",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tickets/manage/{{reviewTicketId}}/file",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "description": "Luồng quản trị vé; chưa chạy request tự động."
          }
        },
        {
          "name": "Review - Recheck pending ticket",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tickets/manage/{{reviewTicketId}}/check",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "description": "Chỉ vé pending. Chạy theo nhu cầu; sau đó đọc lại report khi worker hoàn tất để lấy version/code mới."
          }
        },
        {
          "name": "Review - Approve ticket",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tickets/{{reviewTicketId}}/review",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\",\n  \"checkVersion\": {{checkVersion}},\n  \"selectedCodeId\": \"{{selectedCodeId}}\",\n  \"note\": \"Đã xem file gốc và đối chiếu các cảnh báo.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Chọn vé pending của người khác có check completed và mã đọc được. Lấy version/code từ Ticket report. Với nhiều mã chọn selectedCodeId thủ công. Approve và Reject là lựa chọn thay thế, không chạy cả hai trên cùng vé.\n\nEmail: ticket_approved to seller after the review commits, including automatic approval through the same decision service. Delivery is asynchronous; inspect outbox and inbox. See collection overview for setup."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if(pm.response.code===200){pm.test('Available after review',()=>pm.expect(pm.response.json().data.status).to.eql('available'));pm.environment.set('ticketId',pm.response.json().data.ticket_id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Review - Reject ticket",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tickets/{{reviewTicketId}}/review",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"reject\",\n  \"reason\": \"Thông tin vé không phù hợp với file đính kèm.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Chọn một vé pending khác nếu vé trước đã approve. Không tự duyệt/từ chối vé mình đăng.\n\nEmail: ticket_rejected to seller including rejection reason. Use a separate pending ticket from the purchase flow. Delivery is asynchronous; inspect outbox and inbox. See collection overview for setup."
          }
        }
      ]
    },
