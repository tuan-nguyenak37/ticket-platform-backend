    {
      "name": "03 - Tickets",
      "item": [
        {
          "name": "Create Ticket (POST /api/tickets)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json().data;",
                  "  pm.test(\"Status is pending_review\", () => pm.expect(d.status).to.eql(\"pending_review\"));",
                  "  pm.test(\"Ticket ID generated\", () => pm.expect(d.ticket_id).to.match(/^ticket_/));",
                  "  pm.environment.set(\"ticketId\", d.ticket_id);",
                  "  pm.environment.set(\"reviewTicketId\", d.ticket_id);",
                  "  pm.environment.set(\"myTicketId\", d.ticket_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "eventId",
                  "value": "{{eventId}}",
                  "type": "text"
                },
                {
                  "key": "ticketTier",
                  "value": "VIP",
                  "type": "text"
                },
                {
                  "key": "seatInfo",
                  "value": "A12",
                  "type": "text"
                },
                {
                  "key": "originalPrice",
                  "value": "500000",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "400000",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Bận việc đột xuất nên cần pass lại vé giá mềm",
                  "type": "text"
                },
                {
                  "key": "ticketFile",
                  "type": "file",
                  "src": "D:/HK1-2026_2027/Do_an_nganh/project/backend/.tmp/postman-files/ticket.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ]
            },
            "description": "PDF only. Synthetic ticket.pdf: Demo Concert, 20/12/2028 19:00 Asia/Ho_Chi_Minh, Demo Hall, VIP, A12, originalPrice 500000 VND. Select the matching eventId deliberately. price is the resale price."
          }
        }
      ]
    },
