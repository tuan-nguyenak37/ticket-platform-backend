{
  "info": {
    "name": "Backend - Tickets",
    "description": "Collection kiểm thử API Quản lý Vé (Tickets) trên sàn pass vé TicketVerse. Sử dụng environment Backend Local - Events với baseUrl=http://localhost:7000 (không thêm /api).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Login USER",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"userToken\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login successful\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json().data;",
                  "  pm.test(\"Token received\", () => pm.expect(d.accessToken).to.be.a(\"string\"));",
                  "  pm.environment.set(\"userToken\", d.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Events Prep",
      "item": [
        {
          "name": "Get published events (Lấy eventId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const items = pm.response.json().data?.items;",
                  "  if (Array.isArray(items) && items.length > 0) {",
                  "    pm.environment.set(\"eventId\", items[0].event_id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Tickets",
      "item": [
        {
          "name": "Create Ticket (POST /api/tickets)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json().data;",
                  "  pm.test(\"Status is pending_review\", () => pm.expect(d.status).to.eql(\"pending_review\"));",
                  "  pm.test(\"Ticket ID generated\", () => pm.expect(d.ticket_id).to.match(/^ticket_/));",
                  "  pm.environment.set(\"ticketId\", d.ticket_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "eventId",
                  "value": "{{eventId}}",
                  "type": "text"
                },
                {
                  "key": "ticketTier",
                  "value": "VIP Khán đài A",
                  "type": "text"
                },
                {
                  "key": "seatInfo",
                  "value": "Dãy C - Ghế 15",
                  "type": "text"
                },
                {
                  "key": "originalPrice",
                  "value": "1500000",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "1200000",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Bận việc đột xuất nên cần pass lại vé giá mềm",
                  "type": "text"
                },
                {
                  "key": "ticketFile",
                  "type": "file",
                  "src": "D:/HK1-2026_2027/Do_an_nganh/project/backend/.tmp/postman-files/banner.png"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ]
            }
          }
        }
      ]
    }
  ]
}
