{
  "info": {
    "name": "Backend - Events CRUD",
    "description": "Chỉ gồm request hợp lệ. Chọn Backend Local - Events (baseUrl=http://localhost:7000). Có thể chạy lần lượt: lấy category, đăng nhập, tạo/sửa/công bố/xóa một event, rồi tạo/công bố/hủy/xóa event thứ hai, refresh và xem hồ sơ. crudId là ID được lưu sau khi tạo. Chạy toàn bộ collection sẽ thực hiện thao tác ghi/xóa này. Không chạy đồng thời với collection dùng cùng tài khoản. Sau công bố có ghim → danh sách ghim → bỏ ghim, trước bước xóa. Cần còn một suất ghim khi chạy đoạn này.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - List active event categories (public)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/event-categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "event-categories"
          ]
        },
        "description": "Public. Trả các category đang hoạt động. Lưu categoryId hiện tại nếu vẫn active, hoặc chọn category đầu tiên để dùng trong form sự kiện."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const categories = pm.response.json().data;",
              "  if (Array.isArray(categories)) {",
              "    const selected = categories.find(c => c.category_id === pm.environment.get(\"categoryId\")) || categories[0];",
              "    if (selected) pm.environment.set(\"categoryId\", selected.category_id);",
              "    else pm.environment.unset(\"categoryId\");",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Login ADMIN",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.environment.unset(\"accessToken\");",
              "pm.environment.unset(\"crudId\");",
              "pm.environment.set(\"crudName\", \"CRUD \" + pm.variables.replaceIn(\"{{$guid}}\"));"
            ],
            "type": "text/javascript"
          },
          "listen": "prerequest"
        },
        {
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {const d = pm.response.json().data; pm.test(\"Role\", () => pm.expect(d.user.role).to.eql(\"admin\")); if (d.user.role === \"admin\") pm.environment.set(\"accessToken\", d.accessToken);}"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
