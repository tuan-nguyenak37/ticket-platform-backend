{
  "info": {
    "name": "Backend - Events CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chọn Backend Local - Events. Chạy theo thứ tự. Tạo hai event test riêng, sửa rồi xóa chúng; không dùng eventId của dữ liệu khác. File mẫu local từ .tmp/postman-files."
  },
  "item": [
    {
      "name": "List active event categories (public)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/event-categories",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Public, không cần đăng nhập. Trả data là mảng category đang hoạt động, gồm category_id, name, slug, description, isActive. Dùng category_id cho field categoryId của sự kiện."
      }
    },
    {
      "name": "Login ADMIN",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"accessToken\");",
              "pm.environment.unset(\"crudId\");",
              "pm.environment.set(\"crudName\", \"CRUD \" + pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {const d = pm.response.json().data; pm.test(\"Role\", () => pm.expect(d.user.role).to.eql(\"admin\")); if (d.user.role === \"admin\") pm.environment.set(\"accessToken\", d.accessToken);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Login MODERATOR",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{moderatorEmail}}\",\n  \"password\": \"{{moderatorPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"moderatorToken\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {const d = pm.response.json().data; pm.test(\"Role\", () => pm.expect(d.user.role).to.eql(\"moderator\")); if (d.user.role === \"moderator\") pm.environment.set(\"moderatorToken\", d.accessToken);}"
            ]
          }
        }
      ]
    },
