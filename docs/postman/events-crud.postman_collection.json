    {
      "name": "26 - Refresh session",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh"
          ]
        },
        "description": "Chạy Login của tài khoản muốn dùng trước. Postman tự gửi refresh_token từ cookie jar; không nhập token vào body. Cookie thuộc tài khoản login gần nhất. Request tự lưu sessionAccessToken, sessionUser và cập nhật biến token tương ứng role."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.unset(\"sessionAccessToken\");",
              "pm.environment.unset(\"sessionUser\");"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Refresh 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const d = pm.response.json().data;",
              "  pm.test(\"Access token and user\", () => { pm.expect(d.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(d.user.user_id).to.be.a(\"string\"); pm.expect(d).not.to.have.property(\"refreshToken\"); });",
              "  pm.environment.set(\"sessionAccessToken\", d.accessToken);",
              "  pm.environment.set(\"sessionUser\", JSON.stringify(d.user));",
              "  const key = {admin:\"accessToken\",moderator:\"moderatorToken\",user:\"userToken\"}[d.user.role];",
              "  if (key) pm.environment.set(key, d.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
