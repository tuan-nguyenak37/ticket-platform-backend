    {
      "name": "Create CRUD draft",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/events",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "{{crudName}}",
              "type": "text"
            },
            {
              "key": "venueName",
              "value": "Local test venue",
              "type": "text"
            },
            {
              "key": "address",
              "value": "Ha Noi",
              "type": "text"
            },
            {
              "key": "categoryId",
              "value": "{{categoryId}}",
              "type": "text"
            },
            {
              "key": "status",
              "value": "draft",
              "type": "text"
            },
            {
              "key": "startTime",
              "value": "{{startTime}}",
              "type": "text"
            },
            {
              "key": "endTime",
              "value": "{{endTime}}",
              "type": "text"
            },
            {
              "key": "thumbnail",
              "type": "file",
              "src": "D:/HK1-2026_2027/Do_an_nganh/project/backend/.tmp/postman-files/thumbnail.png"
            },
            {
              "key": "banner",
              "type": "file",
              "src": "D:/HK1-2026_2027/Do_an_nganh/project/backend/.tmp/postman-files/banner.png"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"startTime\",new Date(Date.now()+86400000).toISOString());",
              "pm.variables.set(\"endTime\",new Date(Date.now()+90000000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.environment.set(\"crudId\",pm.response.json().data.event_id);"
            ]
          }
        }
      ]
    },
