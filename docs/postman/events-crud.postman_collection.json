              "if (pm.response.code === 200) {",
              "  const user = pm.response.json().data;",
              "  const previous = pm.environment.get(\"sessionUser\");",
              "  pm.test(\"Same user\", () => { if (previous) pm.expect(user.user_id).to.eql(JSON.parse(previous).user_id); });",
              "  pm.test(\"No password\", () => pm.expect(user).not.to.have.property(\"password\"));",
              "  pm.environment.set(\"sessionUser\", JSON.stringify(user));",
              "}"
            ]
          },
