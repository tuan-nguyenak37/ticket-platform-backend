{
  "info": {
    "name": "Backend - Auth",
    "description": "Các request hợp lệ: đăng nhập, refresh bằng cookie, lấy hồ sơ hiện tại, đăng xuất. Chọn Backend Local - Events (baseUrl=http://localhost:7000, không thêm /api). Login dùng userEmail/userPassword và lưu sessionAccessToken; cookie refresh được Postman giữ tự động.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data;",
              "  pm.environment.set(\"sessionAccessToken\", data.accessToken);",
              "  pm.environment.set(\"sessionUser\", JSON.stringify(data.user));",
              "  const key = { admin: \"accessToken\", moderator: \"moderatorToken\", user: \"userToken\" }[data.user.role];",
              "  if (key) pm.environment.set(key, data.accessToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Refresh session",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh"
          ]
        },
        "description": "Gọi sau login; dùng refresh cookie trong Postman cookie jar."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data;",
              "  pm.environment.set(\"sessionAccessToken\", data.accessToken);",
              "  pm.environment.set(\"sessionUser\", JSON.stringify(data.user));",
              "  const key = { admin: \"accessToken\", moderator: \"moderatorToken\", user: \"userToken\" }[data.user.role];",
              "  if (key) pm.environment.set(key, data.accessToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Get current user",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sessionAccessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "me"
          ]
        }
      },
      "event": [
        {
          "script": {
            "exec": [
              "if (pm.response.code === 200) pm.environment.set(\"sessionUser\", JSON.stringify(pm.response.json().data));"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "04 - Logout",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sessionAccessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const value = pm.environment.get(\"sessionUser\");",
              "  if (value) {",
              "    const role = JSON.parse(value).role;",
              "    const key = { admin: \"accessToken\", moderator: \"moderatorToken\", user: \"userToken\" }[role];",
              "    if (key) pm.environment.unset(key);",
              "  }",
              "  pm.environment.unset(\"sessionAccessToken\");",
              "  pm.environment.unset(\"sessionUser\");",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
