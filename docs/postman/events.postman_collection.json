{
  "info": {
    "name": "Backend - Events",
    "description": "Request hợp lệ cho tạo sự kiện và xem ảnh. Chọn environment Backend Local - Events; baseUrl=http://localhost:7000, không thêm /api. Lấy category trước, đăng nhập role tương ứng rồi gọi API. Script lưu token, ID và tạo thời gian ở tương lai. Các request ghi sẽ thay đổi dữ liệu khi bạn bấm Send hoặc chạy collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set(\"startTime\", new Date(Date.now() + 86400000).toISOString());",
          "pm.variables.set(\"endTime\", new Date(Date.now() + 90000000).toISOString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Login",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"accessToken\");"
                ]
              },
              "listen": "prerequest"
            },
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login successful\", () => pm.response.to.have.status(200));\nif (pm.response.code === 200) { const d = pm.response.json().data; pm.test(\"Correct role\", () => pm.expect(d.user.role).to.eql(\"admin\")); if (d.user.role === \"admin\") pm.environment.set(\"accessToken\", d.accessToken); }"
                ]
              },
              "listen": "test"
            }
          ]
        },
        {
          "name": "Login MODERATOR",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{moderatorEmail}}\",\n  \"password\": \"{{moderatorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"moderatorToken\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login successful\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const d = pm.response.json().data; pm.test(\"Correct role\", () => pm.expect(d.user.role).to.eql(\"moderator\")); if (d.user.role === \"moderator\") pm.environment.set(\"moderatorToken\", d.accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login USER",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"userToken\");"
                ]
              },
              "listen": "prerequest"
            },
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login successful\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const d = pm.response.json().data; pm.test(\"Correct role\", () => pm.expect(d.user.role).to.eql(\"user\")); if (d.user.role === \"user\") pm.environment.set(\"userToken\", d.accessToken); }"
                ]
              },
              "listen": "test"
            }
          ]
        }
      ]
