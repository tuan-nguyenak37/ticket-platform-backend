            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "type": "text",
                  "key": "eventId",
                  "value": "{{eventId}}"
                },
                {
                  "type": "text",
                  "key": "ticketTier",
                  "value": "VIP Khán đài A"
                },
                {
                  "type": "text",
                  "key": "seatInfo",
                  "value": "Dãy C - Ghế 15"
                },
                {
                  "type": "text",
                  "key": "originalPrice",
                  "value": "1500000"
                },
                {
                  "type": "text",
                  "key": "price",
                  "value": "1200000"
                },
                {
                  "type": "text",
