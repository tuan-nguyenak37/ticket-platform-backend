    {
      "name": "List active event categories (public)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/event-categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "event-categories"
          ]
        },
        "description": "Public. Trả các category đang hoạt động. Lưu categoryId hiện tại nếu vẫn active, hoặc chọn category đầu tiên để dùng trong form sự kiện."
      },
      "event": [
        {
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const categories = pm.response.json().data;",
              "  if (Array.isArray(categories)) {",
              "    const selected = categories.find(c => c.category_id === pm.environment.get(\"categoryId\")) || categories[0];",
              "    if (selected) pm.environment.set(\"categoryId\", selected.category_id);",
              "    else pm.environment.unset(\"categoryId\");",
              "  }",
              "}"
            ]
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "ticket",
      "item": [
        {
          "name": "Create Ticket (POST /api/tickets)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
