        {
          "name": "3 - Send both successful payments concurrently",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/me/{{raceOrderA}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{buyerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base=pm.variables.get('baseUrl');",
                  "const a=pm.variables.get('raceOrderA'), b=pm.variables.get('raceOrderB');",
                  "const ta=pm.variables.get('buyerToken'), tb=pm.variables.get('buyer2Token');",
                  "for(const k of ['raceWinnerOrderId','raceLoserOrderId','raceWinnerToken','raceLoserToken']) pm.environment.unset(k);",
                  "if(!a||!b||a===b||!ta||!tb||ta===tb) throw new Error('Prepare distinct buyer accounts, orders and both payment sessions first');",
                  "const send=(id,token)=>new Promise((resolve,reject)=>pm.sendRequest({url:base+'/api/orders/me/'+id+'/payment/mock-result',method:'POST',header:{Authorization:'Bearer '+token,'Content-Type':'application/json'},body:{mode:'raw',raw:JSON.stringify({result:'success'})}},(err,res)=>{",
                  " if(err) return reject(err);",
                  " if(res.code!==200) return reject(new Error('Payment response HTTP '+res.code));",
                  " resolve({data:res.json().data,token});",
                  "}));",
                  "const results=await Promise.all([send(a,ta),send(b,tb)]);",
                  "pm.test('Exactly one paid and one refund_pending',()=>pm.expect(results.map(r=>r.data.status).sort()).to.eql(['paid','refund_pending']));",
                  "pm.test('Same ticket, distinct buyers',()=>{pm.expect(results[0].data.ticketId).to.eql(pm.variables.get('raceTicketId'));pm.expect(results[1].data.ticketId).to.eql(pm.variables.get('raceTicketId'));pm.expect(results[0].data.buyerId).not.to.eql(results[1].data.buyerId);});",
                  "const winner=results.find(r=>r.data.status==='paid'),loser=results.find(r=>r.data.status==='refund_pending');",
                  "if(!winner||!loser) throw new Error('Unexpected allocation; inspect both orders');",
                  "pm.environment.set('raceWinnerOrderId',winner.data.order_id);pm.environment.set('raceLoserOrderId',loser.data.order_id);",
                  "pm.environment.set('raceWinnerToken',winner.token);pm.environment.set('raceLoserToken',loser.token);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
