                "exec": [
                  "if(!pm.variables.get('raceTicketId')) throw new Error('Set raceTicketId to a fresh available test ticket');",
                  "if(!pm.environment.get('raceKeyB')) pm.environment.set('raceKeyB',pm.variables.replaceIn('{{$guid}}'));"
