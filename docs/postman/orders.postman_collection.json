{
  "info": {
    "name": "Backend - Orders",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local mock only. Read docs/orders-api.md. Cancel/dispute/refund/payout are alternative branches. Clear orderKey for a new checkout; retain it for retries. Tokens must belong to separate buyer, seller and manager accounts."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7000"
    },
    {
      "key": "buyerToken",
      "value": ""
    },
    {
      "key": "sellerToken",
      "value": ""
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "orderKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create order",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{orderKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticketId\": \"{{ticketId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('orderKey')) pm.collectionVariables.set('orderKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created or replayed order', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('orderId', pm.response.json().data.order_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List my orders",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/orders/me?side=buyer&page=1&limit=20"
      }
    },
    {
      "name": "Order detail",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/orders/me/{{orderId}}"
      }
    },
    {
      "name": "Cancel unpaid order",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/orders/me/{{orderId}}/cancel"
      }
    },
    {
      "name": "Start mock payment",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/orders/me/{{orderId}}/payment"
      }
    },
    {
      "name": "Mock successful payment",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders/me/{{orderId}}/payment/mock-result",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"result\": \"success\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Download purchased ticket",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/orders/me/{{orderId}}/file"
      }
    },
    {
      "name": "Open dispute",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders/me/{{orderId}}/dispute",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Wrong ticket tier\",\n  \"evidence\": \"Describe evidence here.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Seller dispute reply",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders/me/{{orderId}}/dispute/reply",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"response\": \"Seller explanation here.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Manage orders",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/orders/manage?page=1&limit=20"
      }
    },
    {
      "name": "Manage order detail",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/orders/manage/{{orderId}}"
      }
    },
    {
      "name": "Resolve dispute",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders/manage/{{orderId}}/dispute/resolve",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"accept\",\n  \"note\": \"Evidence checked.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Mock refund",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/orders/manage/{{orderId}}/refund/mock"
      }
    },
    {
      "name": "Mock payout",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/orders/manage/{{orderId}}/payout/mock"
      }
    }
  ]
}
