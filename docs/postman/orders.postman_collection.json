    {
      "name": "Race - Two buyers, one ticket (test data only)",
      "description": "Run this folder only against local development with mock payments enabled. Use a fresh approved PDF ticket in raceTicketId, two distinct buyers and a separate manager. Clear raceKeyA/raceKeyB before a new scenario. Request 3 sends two requests concurrently; sequential Runner requests alone do not test concurrency. Uses no real money. Runtime tokens are stored in the selected environment; do not export/share credential values.",
      "item": [
        {
          "name": "1A - Create order buyer A",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/orders",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{buyerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{raceKeyA}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": \"{{raceTicketId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!pm.variables.get('raceTicketId')) throw new Error('Set raceTicketId to a fresh available test ticket');",
                  "if(!pm.environment.get('raceKeyA')) pm.environment.set('raceKeyA',pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if(pm.response.code===201){ const d=pm.response.json().data; pm.test('Pending without reservation',()=>pm.expect(d.status).to.eql('pending')); pm.environment.set('raceOrderA',d.order_id); }"
                ]
              }
            }
          ]
        },
